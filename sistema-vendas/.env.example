# Nosso banco (PostgreSQL no Docker): superusuário, senha, nome do banco e porta desta máquina
POSTGRES_USER=grupo2
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=grupo2_db
POSTGRES_PORT=3002

# Porta do front (Vite)
FRONT_PORT=3000

# Porta do back (Express), senha do usuário grupo2_app (o da API) e a conexão da API com o nosso banco
PORT=3001
GRUPO2_APP_PASSWORD=troque_esta_senha_da_api
DATABASE_URL=postgres://grupo2_app:troque_esta_senha_da_api@localhost:3002/grupo2_db

# Senha do usuário grupo4_integracao, que o Grupo 4 usa para ler a nossa view
GRUPO4_INTEGRACAO_PASSWORD=troque_esta_senha_do_grupo4

# Conexão com o banco do Grupo 7 (usuário grupo2_consumidor, banco grupo7_db, porta 5437)
GRUPO7_DATABASE_URL=postgresql://grupo2_consumidor:SENHA_DO_GRUPO7@IP_DO_GRUPO7:5437/grupo7_db?sslmode=disable

# Número de registros depois do qual a integração para de propósito (queda simulada); vazia = desligada
INTEGRACAO_SIMULAR_QUEDA_APOS=
