# Copie para .env. Portas seguem a convencao do Dokploy (nenhuma porta e publicada pelo Docker).
FRONT_PORT=3000
PORT=3001
DB_PATH=services/vendas-api/vendas.db

# Chaves da API (chave:perfil). estoque-key e a chave entregue ao G4 (somente GET). Troque em producao.
API_KEYS=vendas-admin-key:admin,estoque-key:leitura

# API de Entregas do G7 (consumida pelo G2). A chave do G2 nao vai para o git:
# coloque so no .env.
ENTREGAS_URL=https://grupo7-apirest.ioshuavps.com.br/api/v1
ENTREGAS_API_KEY=
